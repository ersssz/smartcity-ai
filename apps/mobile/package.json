{
  "name": "astanaai-native-diagnostics",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "android": {
        "exclude": ["expo-location", "expo-task-manager"]
      }
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "typecheck": "tsc --noEmit",
    "test:diagnostic": "node --test tests/walkDiagnostic.test.cjs"
  },
  "dependencies": {
    "expo": "58.0.16",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "expo-dev-client": "58.0.14",
    "expo-location": "58.0.18",
    "expo-task-manager": "58.0.12",
    "expo-sqlite": "58.0.13",
    "expo-speech": "58.0.3",
    "@maplibre/maplibre-react-native": "11.5.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/react": "19.3.0",
    "@types/geojson": "7946.0.16"
  }
}
